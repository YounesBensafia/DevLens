# Set your LLM API key (supports any OpenAI-compatible provider)
LLM_API_KEY=<your_api_key_here>

# Optional: override the API endpoint (default: Groq)
# LLM_API_URL=https://api.openai.com/v1/chat/completions

# Optional: override the model (default: meta-llama/llama-4-scout-17b-16e-instruct)
# LLM_MODEL=gpt-4o-mini

# Backward compatibility (still works):
# GROQ_API_KEY=<your_groq_key>